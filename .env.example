# Secret every agent-side plugin must present. Do not reuse as a human
# password - any agent host that knows this can otherwise read every
# other source's sessions.
INGEST_SECRET=change-me-ingest-secret

# Password for humans logging into the web UI. Leave unset to disable UI
# auth entirely (fine for a trusted local network, not for anything
# internet-reachable).
UI_PASSWORD=change-me-ui-password

# Used to sign the UI session cookie. Any random string; rotate to force
# all UI sessions to re-login.
SESSION_COOKIE_KEY=change-me-random-cookie-signing-key

# Retention: whichever threshold is hit first deletes the oldest whole
# sessions (raw events + derived index).
RETENTION_DAYS=90
RETENTION_MAX_GB=20

# Redaction applied at ingest time, before anything is written to disk.
# Comma-separated regexes; the third default pattern also catches
# secret-shaped tokens (32+ chars of [A-Za-z0-9_-]), which is intentionally
# broad - loosen it if it swallows legitimate long identifiers you rely on.
REDACT_PATTERNS=(?i)password\s*=\s*\S+,(?i)pwd=\S+,[A-Za-z0-9_-]{32,}

# Event payload cap enforced server-side too (defence in depth - the
# plugin already truncates before sending).
MAX_EVENT_PAYLOAD_BYTES=2097152

# Default character limit per feed item in the markdown export.
EXPORT_DEFAULT_LIMIT=1500
